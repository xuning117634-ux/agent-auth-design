<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huawei.it.roma.liveeda.policycenter.infrastructure.mybatis.AgentPolicySkillMapper">
    <resultMap id="AgentPolicySkillResultMap" type="com.huawei.it.roma.liveeda.policycenter.infrastructure.mybatis.AgentPolicySkillRecord">
        <result column="agent_id" property="agentId"/>
        <result column="skill_id" property="skillId"/>
        <result column="skill_name" property="skillName"/>
        <result column="label" property="label"/>
        <result column="description" property="description"/>
    </resultMap>

    <select id="selectBoundSkills" resultMap="AgentPolicySkillResultMap">
        SELECT agent_id, skill_id, skill_name, label, description
        FROM agent_policy_skill
        WHERE agent_id = #{agentId}
          AND status = 1
          AND skill_id IS NOT NULL
          AND skill_id != ''
        ORDER BY skill_id
    </select>
</mapper>
